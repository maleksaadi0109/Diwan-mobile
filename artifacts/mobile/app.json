{
  "expo": {
    "name": "ديوان - Mobile",
    "slug": "mobile",
    "owner": "malek20050109",
    "extra": {
      "eas": {
        "projectId": "5a24650a-7283-44f9-ba6b-79339167ea00"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0b0e",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0a0b0e",
      "package": "com.diwan.arabicpoetry",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      "expo-asset",
      "./plugins/withDiwanDownloader.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
