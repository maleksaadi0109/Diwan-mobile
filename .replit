modules = ["nodejs-20", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["ffmpeg", "openssl", "zlib", "gcc"]

[agent]
expertMode = true

[workflows]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 8084
externalPort = 5173

[[ports]]
localPort = 18115
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 23461
externalPort = 3000

[[ports]]
localPort = 29185
externalPort = 3003

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["sh", "-c", "NODE_ENV=production pnpm --filter @workspace/api-server run build"]
